{
  "name": "delivery-video",
  "version": "1.1.1",
  "description": "Turn a feature that actually runs into a trustworthy delivery demo video, or a defect into a traceable feedback video: real screen recordings, edge-tts narration, word-synced subtitles and a deterministic quality gate (ffmpeg-based, self-contained pipeline).",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v && node --test tests/test_plugin.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "skills/delivery-video/SKILL.md",
    "skills/delivery-video/references/",
    "skills/delivery-video/scripts/preflight.py",
    "skills/delivery-video/scripts/render.py",
    "skills/delivery-video/scripts/verify_delivery.py",
    "examples/",
    "README.md",
    "README_CN.md",
    "LICENSE"
  ],
  "dependencies": {
    "yaml": "^2.4.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Lumos-789/delivery-video-plugin"
  },
  "keywords": [
    "dsh-plugin",
    "delivery",
    "demo-video",
    "bug-report",
    "screen-recording",
    "quality-gate",
    "edge-tts",
    "ffmpeg"
  ]
}
